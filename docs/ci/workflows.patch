diff --git a/.github/workflows/play-release.yml b/.github/workflows/play-release.yml
new file mode 100644
index 0000000..4434b2c
--- /dev/null
+++ b/.github/workflows/play-release.yml
@@ -0,0 +1,129 @@
+name: Play Release
+
+# Uploads a signed release AAB to a Google Play track.
+#
+# Prerequisites (one-time):
+#   1. Release signing secrets: KEYSTORE_BASE64, KEYSTORE_PASSWORD, KEY_ALIAS,
+#      KEY_PASSWORD  -> scripts/set_signing_secrets.sh
+#   2. PLAY_SERVICE_ACCOUNT_JSON: a Play Console service-account key with
+#      "Release to testing tracks" (and later "Release to production") access,
+#      stored as a repository secret.
+#   3. The app must already exist in Play Console with at least one uploaded
+#      build for the package name com.mbbshandbook.app.
+#
+# Manual trigger only: Actions -> Play Release -> Run workflow.
+
+on:
+  workflow_dispatch:
+    inputs:
+      track:
+        description: "Play track to upload to"
+        type: choice
+        options: [internal, alpha, beta, production]
+        default: internal
+      status:
+        description: "Release status"
+        type: choice
+        options: [draft, inProgress, completed]
+        default: draft
+      user_fraction:
+        description: "Staged rollout fraction for production (0.0-1.0, blank = full)"
+        required: false
+        default: ""
+
+concurrency:
+  group: play-release
+  cancel-in-progress: false
+
+permissions:
+  contents: read
+
+jobs:
+  release:
+    name: Build & upload AAB
+    runs-on: ubuntu-latest
+    timeout-minutes: 45
+    environment: play-release
+
+    steps:
+      - name: Checkout
+        uses: actions/checkout@v7
+
+      - name: Set up JDK 17
+        uses: actions/setup-java@v6
+        with:
+          distribution: temurin
+          java-version: "17"
+
+      - name: Ensure Android SDK packages & licenses
+        run: |
+          SDKMANAGER="$(command -v sdkmanager || echo "$ANDROID_HOME/cmdline-tools/latest/bin/sdkmanager")"
+          yes | "$SDKMANAGER" --licenses > /dev/null 2>&1 || true
+          "$SDKMANAGER" "platforms;android-35" "build-tools;34.0.0"
+
+      - name: Set up Gradle
+        uses: gradle/actions/setup-gradle@v6
+        with:
+          cache-read-only: true
+
+      - name: Require release signing
+        env:
+          KEYSTORE_BASE64: ${{ secrets.KEYSTORE_BASE64 }}
+          KEYSTORE_PASSWORD: ${{ secrets.KEYSTORE_PASSWORD }}
+          KEY_ALIAS: ${{ secrets.KEY_ALIAS }}
+          KEY_PASSWORD: ${{ secrets.KEY_PASSWORD }}
+        run: |
+          if [ -z "$KEYSTORE_BASE64" ]; then
+            echo "::error::KEYSTORE_BASE64 is not set. Run scripts/set_signing_secrets.sh first (docs/RELEASE.md)."
+            exit 1
+          fi
+          echo "$KEYSTORE_BASE64" | base64 -d > release-keystore.jks
+          {
+            echo "KEYSTORE_FILE=release-keystore.jks"
+            echo "KEYSTORE_PASSWORD=$KEYSTORE_PASSWORD"
+            echo "KEY_ALIAS=$KEY_ALIAS"
+            echo "KEY_PASSWORD=$KEY_PASSWORD"
+          } >> "$GITHUB_ENV"
+
+      - name: Publish service account key
+        env:
+          PLAY_SERVICE_ACCOUNT_JSON: ${{ secrets.PLAY_SERVICE_ACCOUNT_JSON }}
+        run: |
+          if [ -z "$PLAY_SERVICE_ACCOUNT_JSON" ]; then
+            echo "::error::PLAY_SERVICE_ACCOUNT_JSON is not set. See docs/RELEASE.md."
+            exit 1
+          fi
+          printf '%s' "$PLAY_SERVICE_ACCOUNT_JSON" > play-service-account.json
+          chmod 600 play-service-account.json
+
+      - name: Run unit tests
+        run: ./gradlew testDebugUnitTest --stacktrace
+
+      - name: Validate Play listing
+        run: |
+          python3 -m pip install --quiet --upgrade pillow
+          python3 scripts/check_store_listing.py
+
+      - name: Build signed AAB
+        env:
+          REQUIRE_RELEASE_SIGNING: "true"
+        run: ./gradlew verifyReleaseSigning bundleRelease --stacktrace
+
+      - name: Verify AAB signature
+        run: ./scripts/verify-release-signing.sh app/build/outputs/bundle/release/app-release.aab
+
+      - name: Upload to Google Play
+        uses: r0adkll/upload-google-play@v1
+        with:
+          serviceAccountJsonPlainText: ${{ secrets.PLAY_SERVICE_ACCOUNT_JSON }}
+          packageName: com.mbbshandbook.app
+          releaseFiles: app/build/outputs/bundle/release/app-release.aab
+          track: ${{ inputs.track }}
+          status: ${{ inputs.status }}
+          userFraction: ${{ inputs.user_fraction }}
+          whatsNewDirectory: fastlane/metadata/android/en-US/changelogs
+          mappingFile: app/build/outputs/mapping/release/mapping.txt
+
+      - name: Clean up service account key
+        if: always()
+        run: rm -f play-service-account.json release-keystore.jks

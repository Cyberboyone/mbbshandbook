<?xml version="1.0" encoding="utf-8"?>
<!--
  Play upload hardening: all network traffic (AdMob, UMP, the in-app privacy
  policy link) must be HTTPS. Cleartext traffic is disabled app-wide.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
